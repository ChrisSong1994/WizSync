--- a/dist/index.js
+++ b/dist/index.js
@@ -125,7 +125,12 @@ function resolvePackageJson(root = process.cwd()) {
 }
 function treeKillSync(pid) {
   if (process.platform === "win32") {
-    cp.execSync(`taskkill /pid ${pid} /T /F`);
+    // 进程可能已经退出（例如应用正常关闭后 vite 再次清理），taskkill 会报“没有找到进程”，
+    // 这里忽略该错误并屏蔽输出，避免 dev 进程因此崩溃。
+    try {
+      cp.execSync(`taskkill /pid ${pid} /T /F`, { stdio: "ignore" });
+    } catch {
+    }
   } else {
     killTree(pidTree({ pid, ppid: process.pid }));
   }
