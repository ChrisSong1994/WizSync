{
  "name": "wizsync",
  "version": "1.1.0",
  "description": "Clean and professional directory sync app powered by Unison",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "build": "node scripts/build.mjs",
    "build:mac": "node scripts/build.mjs mac",
    "build:win": "node scripts/build.mjs win",
    "build:linux": "node scripts/build.mjs linux",
    "fetch:unison": "node scripts/fetch-unison.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "ChrisSong1994",
  "dependencies": {
    "clsx": "^2.1.0",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.2"
  },
  "build": {
    "appId": "com.wizsync.app",
    "productName": "WizSync",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "asarUnpack": [
      "src/resources/bin/**/*"
    ],
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "src/resources/bin/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "public/assets/icon-512.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "public/assets/icon-512.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WizSync"
    },
    "linux": {
      "icon": "public/assets/icon-512.png",
      "category": "Utility",
      "maintainer": "ChrisSong1994 <ChrisSong1994@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^29.1.6",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.10"
  }
}
